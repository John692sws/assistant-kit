[Unit]
Description={{NOM_ASSISTANT}}: dashboard (lecture seule, réseau privé)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory={{HOME}}/workspace/projects/active/ultron-hub
Environment=LANG=C.UTF-8
Environment=PYTHONUNBUFFERED=1
ExecStart={{HOME}}/workspace/projects/active/ultron-hub/.venv/bin/ultron-hub dashboard serve --port 8787
Restart=on-failure
RestartSec=10
RestartPreventExitStatus=78

[Install]
WantedBy=default.target
