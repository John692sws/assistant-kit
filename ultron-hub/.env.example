# Copier en .env si besoin. Noms seulement, aucune valeur sensible ici.
# Racine du projet (par défaut : déduite de l'emplacement du code)
ULTRON_HUB_ROOT=
# Chemin du binaire claude (par défaut : which claude, puis ~/.local/bin/claude)
ULTRON_HUB_CLAUDE_BIN=
# Niveau de log (DEBUG, INFO, WARNING, ERROR)
ULTRON_HUB_LOG_LEVEL=
