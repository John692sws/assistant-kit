[Unit]
Description=ultron-hub: push quotidien de main et des tags vers le GitHub privé
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory={{HOME}}/workspace/projects/active/ultron-hub
Environment=PATH={{HOME}}/.local/bin:/usr/bin:/bin
Environment=LANG=C.UTF-8
ExecStart={{HOME}}/workspace/projects/active/ultron-hub/.venv/bin/ultron-hub depot push
TimeoutStartSec=300
